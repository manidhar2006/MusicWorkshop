# Python environments and caches
venv*/
__pycache__/
.ipynb_checkpoints/

# Downloaded data and models (records stream from PhysioNet on demand)
data/
models/
external/

# Rendered audio is large and can be regenerated from the tracked MIDI files
# (re-run sonifying_the_heart.ipynb with RENDER_AUDIO = True)
*.wav

# Analyses of your own ECG files can contain personal health data
output/analysis/

# Listening-study responses can identify classmates
responses.csv

# The study's 16 blinded mp3s: regenerate from section 11 of sonifying_the_heart.ipynb, which
# is deterministic. KEY.csv is tracked, so the mapping survives a fresh clone.
output/listening_study/*.mp3

# The gallery's audio is 21 MB and regenerable from the notebook's appendix. Its ECG images and
# MAPPING.csv / MAPPING.md are small and are tracked, so the mapping is readable from a clone.
output/gallery/audio/
