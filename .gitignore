# Python environments and caches
venv*/
__pycache__/
.ipynb_checkpoints/

# Downloaded data and models (records stream on demand or `python -m ecgmusic download` re-fetches them;
# Essentia models download on first use)
data/
models/
external/

# Rendered audio is large and can be regenerated from the tracked MIDI files
*.wav

# Analyses of your own ECG files can contain personal health data
output/analysis/

# sonifying_the_heart.ipynb writes here, so a notebook run never disturbs output/
output_nb/

# The study's 16 blinded mp3s: regenerate with `python -m ecgmusic.build_study`, which is
# deterministic. KEY.csv and key.json are tracked, so the mapping survives a fresh clone.
output/listening_study/*.mp3
